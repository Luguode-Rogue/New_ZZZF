<?xml version="1.0" encoding="utf-8"?>
<Prefab>
  <Window>

    <!-- ============================================================
         SkillSelectionPopup  —  技能选择弹窗 (重制版)
         DataSource : New_ZZZF.SkillSelectionVM
           Title / IsVisible / SearchText / FilteredSkills / ExecuteClose
         ItemTemplate DataSource : New_ZZZF.SkillItemVM
           SkillName / TypeText / Description / CooldownLabel / CostLabel
           IsHighlighted / IsSelectable / ExecuteSelect
         ============================================================ -->

    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
            IsVisible="@IsVisible">
      <Children>

        <!-- 点击遮罩关闭 -->
        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                      Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.7"
                      Command.Click="ExecuteClose"
                      DoNotPassEventsToChildren="true" UpdateChildrenStates="true" />

        <!-- ==================== 弹窗主体 ==================== -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="1100" SuggestedHeight="760"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <Children>

            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    Sprite="BlankWhiteSquare_9" Color="#14110AFF" AlphaFactor="0.98" />
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    Sprite="StdAssets\selection_border_9" Color="#9C7A3CFF" />

            <!-- = 标题栏 = -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="66"
                    VerticalAlignment="Top">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="BlankWhiteSquare_9" Color="#241E15FF" />

                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                            MarginLeft="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Brush="Clan.Header.Text" Text="@Title" />

                <!-- 关闭 X -->
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="42" SuggestedHeight="42"
                              MarginRight="14" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Brush="ButtonBrush2" Command.Click="ExecuteClose"
                              DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                Brush="Clan.Card.Name" Text="X" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>

            <!-- = 搜索栏 = -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="56"
                    VerticalAlignment="Top" MarginTop="66">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40"
                        MarginLeft="24" MarginRight="24" VerticalAlignment="Center">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Sprite="BlankWhiteSquare_9" Color="#0C0A07FF" />
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Sprite="StdAssets\selection_border_9" Color="#6A5630FF" />

                    <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                SuggestedWidth="80" MarginLeft="10"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Brush="Clan.Card.Text" Color="#8A7F6E" Text="搜索" />

                    <EditableTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        MarginLeft="88" MarginRight="12"
                                        Brush="Clan.Card.Text" Text="@SearchText" />
                  </Children>
                </Widget>
              </Children>
            </Widget>

            <!-- = 技能列表 = -->
            <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                             MarginTop="128" MarginBottom="80" MarginLeft="20" MarginRight="20"
                             ClipRect="PopupClip" InnerPanel="PopupClip\PopupInner"
                             AutoHideScrollBars="false" VerticalScrollbar="..\PopupScrollbar">
              <Children>
                <Widget Id="PopupClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        ClipContents="true">
                  <Children>
                    <ListPanel Id="PopupInner" WidthSizePolicy="StretchToParent"
                               HeightSizePolicy="CoverChildren"
                               LayoutImp.LayoutMethod="VerticalBottomToTop"
                               DataSource="{FilteredSkills}">
                      <ItemTemplate>
                        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                      SuggestedHeight="82" MarginBottom="6"
                                      MarginLeft="8" MarginRight="8"
                                      Brush="ButtonBrush2" Command.Click="ExecuteSelect"
                                      DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                                    <Children>
                            <!-- 键盘高亮 -->
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Sprite="StdAssets\selection_border_9" Color="#F0C060FF"
                                    IsVisible="@IsHighlighted" />

                            <!-- 类型徽标 -->
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                    SuggestedWidth="86" SuggestedHeight="28"
                                    MarginLeft="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    MarginTop="10">
                              <Children>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        Sprite="BlankWhiteSquare_9" Color="#3A2E18FF" />
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                            Brush="Clan.Card.Text" Color="#D8B060FF" Text="@TypeText" />
                              </Children>
                            </Widget>

                            <!-- 技能名 -->
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                        SuggestedHeight="30" VerticalAlignment="Top" MarginTop="8"
                                        MarginLeft="112" MarginRight="300" HorizontalAlignment="Left"
                                        Brush="Clan.Card.Name" Text="@SkillName" />

                            <!-- 描述 -->
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                        SuggestedHeight="30" VerticalAlignment="Bottom" MarginBottom="8"
                                        MarginLeft="20" MarginRight="300" HorizontalAlignment="Left"
                                        Brush="Clan.Card.Text" Color="#9A9084" Text="@Description" />

                            <!-- 右侧数值 -->
                            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                       MarginRight="18" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       LayoutImp.LayoutMethod="HorizontalLeftToRight">
                              <Children>
                                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                            MarginRight="20" VerticalAlignment="Center"
                                            Brush="Clan.Card.Text" Color="#7FB0E0FF" Text="@CooldownLabel" />
                                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                            VerticalAlignment="Center"
                                            Brush="Clan.Card.Text" Color="#C070D0FF" Text="@CostLabel" />
                              </Children>
                            </ListPanel>
                          </Children>
                        </ButtonWidget>
                      </ItemTemplate>
                    </ListPanel>
                  </Children>
                </Widget>
              </Children>
            </ScrollablePanel>

            <ScrollbarWidget Id="PopupScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                             SuggestedWidth="12" HorizontalAlignment="Right"
                             MarginTop="132" MarginBottom="84" MarginRight="4"
                             AlignmentAxis="Vertical" MinValue="0" MaxValue="100"
                             Handle="PopupHandle">
              <Children>
                <Widget Id="PopupHandle" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                        MinHeight="20" Sprite="BlankWhiteSquare_9" Color="#9C7A3CFF" />
              </Children>
            </ScrollbarWidget>

            <!-- = 底部 = -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="80"
                    VerticalAlignment="Bottom">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="BlankWhiteSquare_9" Color="#241E15FF" />

                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                            MarginLeft="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Brush="Clan.Card.Text" Color="#7A7165"
                            Text="↑↓ 选择    Enter 确认    Esc 取消" />

                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="150" SuggestedHeight="46"
                              MarginRight="24" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Brush="ButtonBrush2" Command.Click="ExecuteClose"
                              DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                Brush="Clan.Card.Text" Text="取消" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
