<?xml version="1.0" encoding="utf-8"?>
<Prefab>
  <Window>

    <!-- ============================================================
         CustomSkillScreen  —  技能配置主界面 (重制版)
         DataSource : New_ZZZF.GUI.CustomSkillScreenVM
         布局       : 左 [英雄名册] | 中 [槽位 / 技能目录 切换区] | 右 [熟练度]
         底部       : 操作条 (导出 / 撤销 / 应用 / 关闭 / 调试)
         ============================================================ -->

    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- 全屏背景遮罩 -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.75" />

        <!-- ==================== 主面板 ==================== -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="1720" SuggestedHeight="940"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <Children>

            <!-- 面板底板 -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    Sprite="BlankWhiteSquare_9" Color="#12100CFF" AlphaFactor="0.97" />
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    Sprite="StdAssets\selection_border_9" Color="#9C7A3CFF" AlphaFactor="0.9" />

            <!-- = 顶部标题栏 = -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="72"
                    VerticalAlignment="Top">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="BlankWhiteSquare_9" Color="#241E15FF" />

                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                            MarginLeft="32" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Brush="Clan.Header.Text" Text="技能配置" />

                <!-- 当前英雄 -->
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                            MarginLeft="220" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Brush="Clan.Card.Name" Text="@CurrentHero.HeroName" />

                <!-- 未保存标记 -->
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                            MarginRight="240" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Brush="Clan.Card.Name" Color="#E0A030FF"
                            Text="● 未保存" IsVisible="@IsDirty" />

                <!-- 目标类型切换 -->
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="200" SuggestedHeight="44"
                              MarginRight="24" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Brush="ButtonBrush2" Command.Click="ExecuteCycleTargetType"
                              DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                Brush="Clan.Card.Name" Text="@TargetTypeText" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>

            <!-- = 内容区 = -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    MarginTop="72" MarginBottom="88" MarginLeft="20" MarginRight="20">
              <Children>

                <!-- ========== 左栏：英雄名册 ========== -->
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                        SuggestedWidth="330" HorizontalAlignment="Left">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Sprite="BlankWhiteSquare_9" Color="#1B1710FF" />

                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                SuggestedHeight="44" VerticalAlignment="Top"
                                Brush="Clan.Card.Name" Text="英雄名册" />

                        <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                         MarginTop="48" MarginBottom="8"
                                         ClipRect="RosterClip" InnerPanel="RosterClip\RosterInner"
                                         AutoHideScrollBars="false" VerticalScrollbar="..\RosterScrollbar">
                      <Children>
                        <Widget Id="RosterClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                ClipContents="true">
                          <Children>
                            <ListPanel Id="RosterInner" WidthSizePolicy="StretchToParent"
                                       HeightSizePolicy="CoverChildren" LayoutImp.LayoutMethod="VerticalBottomToTop"
                                       DataSource="{Roster}">
                              <ItemTemplate>
                                <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                              SuggestedHeight="58" MarginBottom="4"
                                              MarginLeft="8" MarginRight="8"
                                              Brush="ButtonBrush2" Command.Click="ExecuteSelect"
                                              DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                                  <Children>
                                    <!-- 选中高亮 -->
                                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                            Sprite="BlankWhiteSquare_9" Color="#C89B4AFF" AlphaFactor="0.28"
                                            IsVisible="@IsSelected" />

                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                                SuggestedHeight="28" VerticalAlignment="Top" MarginTop="4"
                                                MarginLeft="12" HorizontalAlignment="Left"
                                                Brush="Clan.Card.Name" Text="@HeroName" />

                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                                SuggestedHeight="22" VerticalAlignment="Bottom" MarginBottom="4"
                                                MarginLeft="12" HorizontalAlignment="Left"
                                                Brush="Clan.Card.Text" Text="@Subtitle" />
                                  </Children>
                                </ButtonWidget>
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>

                    <ScrollbarWidget Id="RosterScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                     SuggestedWidth="12" HorizontalAlignment="Right"
                                     MarginTop="52" MarginBottom="10" MarginRight="4"
                                     AlignmentAxis="Vertical" MinValue="0" MaxValue="100"
                                     Handle="RosterHandle">
                      <Children>
                        <Widget Id="RosterHandle" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                MinHeight="20" Sprite="BlankWhiteSquare_9" Color="#9C7A3CFF" />
                      </Children>
                    </ScrollbarWidget>
                  </Children>
                </Widget>

                <!-- ========== 中栏：槽位 / 目录 ========== -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        MarginLeft="342" MarginRight="342">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Sprite="BlankWhiteSquare_9" Color="#171309FF" />

                    <!-- = 视图 A：技能槽位 = -->
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            IsVisible="@IsShowingSlots">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                    SuggestedHeight="44" VerticalAlignment="Top"
                                    Brush="Clan.Card.Name" Text="技能槽位" />

                        <GridWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                   MarginTop="48" MarginBottom="8" MarginLeft="12" MarginRight="12"
                                   DataSource="{Skills}" LayoutImp="GridLayout"
                                   ColumnCount="4" DefaultCellWidth="170" DefaultCellHeight="90"
                                   HorizontalAlignment="Center">
                          <ItemTemplate>
                            <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                          Brush="ButtonBrush2" Command.Click="ExecuteClick"
                                          DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                              <Children>
                                <!-- 槽位标签（顶部） -->
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                            SuggestedHeight="20" VerticalAlignment="Top" MarginTop="3"
                                            HorizontalAlignment="Center"
                                            Brush="Clan.Card.Text" Color="#C9A96AFF" Text="@SlotLabel" />

                                <!-- 技能名 / 空槽提示 -->
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                            SuggestedHeight="28" VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Brush="Clan.Card.Name" Text="@SkillName"
                                            IsVisible="@IsEquipped" />
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                            SuggestedHeight="28" VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Brush="Clan.Card.Text" Color="#6A6055FF" Text="— 空槽 —"
                                            IsVisible="@IsEmpty" />

                                <!-- 冷却 + 消耗（底部） -->
                                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed"
                                           SuggestedHeight="18" VerticalAlignment="Bottom" MarginBottom="3"
                                           HorizontalAlignment="Center"
                                           LayoutImp.LayoutMethod="HorizontalLeftToRight"
                                           IsVisible="@IsEquipped">
                                  <Children>
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                                MarginRight="10" Brush="Clan.Card.Text" FontSize="11"
                                                Color="#7FB0E0FF" Text="@CooldownText" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                                Brush="Clan.Card.Text" FontSize="11"
                                                Color="#C070D0FF" Text="@CostText" />
                                  </Children>
                                </ListPanel>
                              </Children>
                            </ButtonWidget>
                          </ItemTemplate>
                        </GridWidget>
                      </Children>
                    </Widget>

                    <!-- = 视图 B：技能目录 = -->
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            IsVisible="@IsInCatalogView">
                      <Children>

                        <!-- 目录标题栏：返回 + 搜索 -->
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="52"
                                VerticalAlignment="Top">
                          <Children>
                                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                                  SuggestedWidth="96" SuggestedHeight="38"
                                                  MarginLeft="10" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Brush="ButtonBrush2" Command.Click="ExecuteCloseCatalog"
                                                  DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                            Brush="Clan.Card.Text" Text="← 返回" />
                              </Children>
                            </ButtonWidget>

                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                        MarginLeft="120" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Brush="Clan.Card.Name" Text="选择技能" />

                            <!-- 搜索框 -->
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                    SuggestedWidth="330" SuggestedHeight="38"
                                    MarginRight="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                              <Children>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        Sprite="BlankWhiteSquare_9" Color="#0C0A07FF" />
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        Sprite="StdAssets\selection_border_9" Color="#6A5630FF" />
                                <EditableTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                    MarginLeft="10" MarginRight="10"
                                                    Brush="Clan.Card.Text" Text="@SearchText" />
                              </Children>
                            </Widget>
                          </Children>
                        </Widget>

                        <!-- 目录网格（可滚动） -->
                        <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                         MarginTop="56" MarginBottom="8"
                                         ClipRect="CatalogClip" InnerPanel="CatalogClip\CatalogGrid"
                                         AutoHideScrollBars="false" VerticalScrollbar="..\CatalogScrollbar">
                          <Children>
                            <Widget Id="CatalogClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    ClipContents="true">
                              <Children>
                                <GridWidget Id="CatalogGrid" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                           DataSource="{CatalogItems}" LayoutImp="GridLayout"
                                           ColumnCount="4" DefaultCellWidth="230" DefaultCellHeight="168">
                                  <ItemTemplate>
                                    <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                  Brush="ButtonBrush2" Command.Click="ExecuteSelect"
                                                  IsEnabled="@IsSelectable"
                                                  DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                                      <Children>
                                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                Sprite="StdAssets\selection_border_9" Color="#F0C060FF"
                                                IsVisible="@IsHighlighted" />

                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                                    SuggestedHeight="30" VerticalAlignment="Top" MarginTop="6"
                                                    MarginLeft="8" MarginRight="8"
                                                    Brush="Clan.Card.Name" Text="@SkillName" />

                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                                    SuggestedHeight="22" VerticalAlignment="Top" MarginTop="36"
                                                    Brush="Clan.Card.Text" Color="#C9A96AFF" Text="@TypeText" />

                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                                    SuggestedHeight="52" VerticalAlignment="Center" MarginTop="20"
                                                    MarginLeft="10" MarginRight="10"
                                                    Brush="Clan.Card.Text" Color="#9A9084" Text="@Description" />

                                        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed"
                                                   SuggestedHeight="22" VerticalAlignment="Bottom" MarginBottom="8"
                                                   HorizontalAlignment="Center"
                                                   LayoutImp.LayoutMethod="HorizontalLeftToRight">
                                          <Children>
                                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                                        MarginRight="16" Brush="Clan.Card.Text" Color="#7FB0E0FF"
                                                        Text="@CooldownLabel" />
                                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                                        Brush="Clan.Card.Text" Color="#C070D0FF" Text="@CostLabel" />
                                          </Children>
                                        </ListPanel>
                                      </Children>
                                    </ButtonWidget>
                                  </ItemTemplate>
                                </GridWidget>
                              </Children>
                            </Widget>
                          </Children>
                        </ScrollablePanel>

                        <ScrollbarWidget Id="CatalogScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                         SuggestedWidth="12" HorizontalAlignment="Right"
                                         MarginTop="56" MarginBottom="8" MarginRight="2"
                                         AlignmentAxis="Vertical" MinValue="0" MaxValue="100"
                                         Handle="CatalogHandle">
                          <Children>
                            <Widget Id="CatalogHandle" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                    MinHeight="20" Sprite="BlankWhiteSquare_9" Color="#9C7A3CFF" />
                          </Children>
                        </ScrollbarWidget>
                      </Children>
                    </Widget>
                  </Children>
                </Widget>

                <!-- ========== 右栏：熟练度 ========== -->
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                        SuggestedWidth="330" HorizontalAlignment="Right">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Sprite="BlankWhiteSquare_9" Color="#1B1710FF" />

                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                SuggestedHeight="44" VerticalAlignment="Top"
                                Brush="Clan.Card.Name" Text="技能熟练度" />

                    <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                     MarginTop="48" MarginBottom="8"
                                     ClipRect="ProfClip" InnerPanel="ProfClip\ProfInner"
                                     AutoHideScrollBars="false" VerticalScrollbar="..\ProfScrollbar">
                      <Children>
                        <Widget Id="ProfClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                ClipContents="true">
                          <Children>
                            <ListPanel Id="ProfInner" WidthSizePolicy="StretchToParent"
                                       HeightSizePolicy="CoverChildren"
                                       LayoutImp.LayoutMethod="VerticalBottomToTop"
                                       DataSource="{Proficiencies}">
                              <ItemTemplate>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                        SuggestedHeight="46" MarginLeft="8" MarginRight="8" MarginBottom="4">
                                  <Children>
                                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                            Sprite="BlankWhiteSquare_9" Color="#221D14FF" />

                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                MarginLeft="12" MarginRight="72" HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Brush="Clan.Card.Text" Text="@SkillName" />

                                    <!-- 数值徽标 -->
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                            SuggestedWidth="58" SuggestedHeight="28"
                                            MarginRight="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                      <Children>
                                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.55" />
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                    Brush="Clan.Card.Name" Color="#E0C070FF" Text="@DisplayText" />
                                      </Children>
                                    </Widget>
                                  </Children>
                                </Widget>
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>

                    <ScrollbarWidget Id="ProfScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                     SuggestedWidth="12" HorizontalAlignment="Right"
                                     MarginTop="52" MarginBottom="10" MarginRight="4"
                                     AlignmentAxis="Vertical" MinValue="0" MaxValue="100"
                                     Handle="ProfHandle">
                      <Children>
                        <Widget Id="ProfHandle" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                MinHeight="20" Sprite="BlankWhiteSquare_9" Color="#9C7A3CFF" />
                      </Children>
                    </ScrollbarWidget>
                  </Children>
                </Widget>
              </Children>
            </Widget>

            <!-- = 底部操作条 = -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="88"
                    VerticalAlignment="Bottom">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="BlankWhiteSquare_9" Color="#241E15FF" />

                <!-- 状态文本 -->
                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                            SuggestedWidth="520" MarginLeft="28"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Brush="Clan.Card.Text" Color="#9A9084" Text="@ExportStatusText" />

                <!-- 按钮组 -->
                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                           MarginRight="24" HorizontalAlignment="Right" VerticalAlignment="Center"
                           LayoutImp.LayoutMethod="HorizontalLeftToRight">
                  <Children>

                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="130" SuggestedHeight="46" MarginRight="10"
                                  VerticalAlignment="Center" Brush="ButtonBrush2"
                                  Command.Click="ExecuteToggleDebug" IsVisible="@DebugMode"
                                  DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Brush="Clan.Card.Text" Text="调试中" />
                      </Children>
                    </ButtonWidget>

                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="150" SuggestedHeight="46" MarginRight="10"
                                  VerticalAlignment="Center" Brush="ButtonBrush2"
                                  Command.Click="ExecuteOpenSpellForge"
                                  DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Brush="Clan.Card.Text" Text="法术锻造" />
                      </Children>
                    </ButtonWidget>

                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="130" SuggestedHeight="46" MarginRight="10"
                                  VerticalAlignment="Center" Brush="ButtonBrush2"
                                  Command.Click="ExecuteExport"
                                  DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Brush="Clan.Card.Text" Text="导出" />
                      </Children>
                    </ButtonWidget>

                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="130" SuggestedHeight="46" MarginRight="10"
                                  VerticalAlignment="Center" Brush="ButtonBrush2"
                                  Command.Click="ExecuteUndoChanges" IsEnabled="@IsDirty"
                                  DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Brush="Clan.Card.Text" Text="撤销" />
                      </Children>
                    </ButtonWidget>

                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="150" SuggestedHeight="46" MarginRight="10"
                                  VerticalAlignment="Center" Brush="ButtonBrush1"
                                  Command.Click="ExecuteApply"
                                  DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Brush="Clan.Card.Name" Text="应用" />
                      </Children>
                    </ButtonWidget>

                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="130" SuggestedHeight="46"
                                  VerticalAlignment="Center" Brush="ButtonBrush2"
                                  Command.Click="ExecuteClose"
                                  DoNotPassEventsToChildren="true" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Brush="Clan.Card.Text" Text="关闭" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>
              </Children>
            </Widget>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
