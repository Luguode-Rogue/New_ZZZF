<Project>
  <PropertyGroup>
    <HtmlUiModuleDeployDir Condition="'$(HtmlUiModuleDeployDir)' == ''">$(GameFolder)\Modules\$(ModuleId)</HtmlUiModuleDeployDir>
    <HtmlUiBinaryDeployDir Condition="'$(HtmlUiBinaryDeployDir)' == ''">$(HtmlUiModuleDeployDir)\bin\$(GameBinariesFolder)</HtmlUiBinaryDeployDir>

    <CustomSkillHtmlUiSource>$(MSBuildProjectDirectory)\GUI\Html\CustomSkill</CustomSkillHtmlUiSource>
    <CustomSkillHtmlUiDeploy>$(HtmlUiBinaryDeployDir)\CustomSkillUI</CustomSkillHtmlUiDeploy>

    <TacticalMapHtmlUiSource>$(MSBuildProjectDirectory)\TacticalMap\UI\TacticalMap</TacticalMapHtmlUiSource>
    <TacticalMapHtmlUiDeploy>$(HtmlUiBinaryDeployDir)\UI\TacticalMap</TacticalMapHtmlUiDeploy>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BannerlordHtmlUI">
      <HintPath>$(GameFolder)\Modules\BannerlordHtmlUI\bin\Win64_Shipping_Client\BannerlordHtmlUI.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Remove="Bannerlord.MBOptionScreen.v1.0.1" />
    <Reference Include="Bannerlord.MBOptionScreen.v1.0.1">
      <HintPath>..\..\..\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\Bannerlord.MBOptionScreen.v1.0.1.dll</HintPath>
    </Reference>
    <Reference Remove="Bannerlord.MBOptionScreen.v1.0.2" />
    <Reference Include="Bannerlord.MBOptionScreen.v1.0.2">
      <HintPath>..\..\..\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\Bannerlord.MBOptionScreen.v1.0.2.dll</HintPath>
    </Reference>
    <Reference Remove="Bannerlord.MBOptionScreen.v1.0.3" />
    <Reference Include="Bannerlord.MBOptionScreen.v1.0.3">
      <HintPath>..\..\..\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\Bannerlord.MBOptionScreen.v1.0.3.dll</HintPath>
    </Reference>
    <Reference Remove="StoryMode.GauntletUI.AutoGenerated" />
    <Reference Include="StoryMode.GauntletUI.AutoGenerated">
      <HintPath>..\..\..\StoryMode\bin\Win64_Shipping_Client\StoryMode.GauntletUI.AutoGenerated.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="DeployNewZZZFDll"
          AfterTargets="Build"
          Condition="'$(TargetFramework)' == 'net472' and Exists('$(GameFolder)\Modules\BannerlordHtmlUI\bin\Win64_Shipping_Client\BannerlordHtmlUI.dll') and Exists('$(TargetPath)')">
    <Message Importance="High" Text="[New_ZZZF] Deploy managed assembly: '$(TargetPath)' -> '$(HtmlUiBinaryDeployDir)\$(TargetFileName)'" />
    <MakeDir Directories="$(HtmlUiBinaryDeployDir)" />
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFiles="$(HtmlUiBinaryDeployDir)\$(TargetFileName)"
      SkipUnchangedFiles="true" />
    <WriteLinesToFile
      File="$(HtmlUiBinaryDeployDir)\New_ZZZF.buildstamp.txt"
      Lines="Module=New_ZZZF;Target=$(TargetPath);Deployed=$(HtmlUiBinaryDeployDir)\$(TargetFileName);BuildConfiguration=$(Configuration);TargetFramework=$(TargetFramework)"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>

  <Target Name="DeployCustomSkillHtmlUi"
          AfterTargets="Build"
          Condition="'$(TargetFramework)' == 'net472' and Exists('$(GameFolder)\Modules\BannerlordHtmlUI\bin\Win64_Shipping_Client\BannerlordHtmlUI.dll') and Exists('$(CustomSkillHtmlUiSource)')">
    <Message Importance="High" Text="[CustomSkill] Deploy HtmlUI: '$(CustomSkillHtmlUiSource)' -> '$(CustomSkillHtmlUiDeploy)'" />
    <MakeDir Directories="$(CustomSkillHtmlUiDeploy)" />
    <ItemGroup>
      <_CustomSkillHtmlFiles Include="$(CustomSkillHtmlUiSource)\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_CustomSkillHtmlFiles)"
      DestinationFiles="@(_CustomSkillHtmlFiles->'$(CustomSkillHtmlUiDeploy)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="DeployTacticalMapHtmlUi"
          AfterTargets="Build"
          Condition="'$(TargetFramework)' == 'net472' and Exists('$(GameFolder)\Modules\BannerlordHtmlUI\bin\Win64_Shipping_Client\BannerlordHtmlUI.dll') and Exists('$(TacticalMapHtmlUiSource)')">
    <Message Importance="High" Text="[TacticalMap] Deploy HtmlUI: '$(TacticalMapHtmlUiSource)' -> '$(TacticalMapHtmlUiDeploy)'" />
    <MakeDir Directories="$(TacticalMapHtmlUiDeploy)" />
    <ItemGroup>
      <_TacticalMapHtmlFiles Include="$(TacticalMapHtmlUiSource)\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_TacticalMapHtmlFiles)"
      DestinationFiles="@(_TacticalMapHtmlFiles->'$(TacticalMapHtmlUiDeploy)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CleanupLegacyTacticalMapHtmlUi"
          AfterTargets="Build"
          Condition="'$(TargetFramework)' == 'net472'">
    <PropertyGroup>
      <_LegacyTacticalMapGameDir>$(HtmlUiBinaryDeployDir)\TacticalMapUI</_LegacyTacticalMapGameDir>
      <_LegacyTacticalMapBuildDir>$(TargetDir)TacticalMapUI</_LegacyTacticalMapBuildDir>
    </PropertyGroup>
    <Message Importance="Normal" Text="[TacticalMap] Removing legacy HtmlUI outputs if present." />
    <RemoveDir Directories="$(_LegacyTacticalMapGameDir)" Condition="Exists('$(_LegacyTacticalMapGameDir)')" />
    <RemoveDir Directories="$(_LegacyTacticalMapBuildDir)" Condition="Exists('$(_LegacyTacticalMapBuildDir)')" />
  </Target>
</Project>
